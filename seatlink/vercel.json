{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/display", "destination": "/index.html" },
    { "source": "/display/", "destination": "/index.html" },
    { "source": "/owner", "destination": "/index.html" },
    { "source": "/owner/", "destination": "/index.html" }
  ]
}
